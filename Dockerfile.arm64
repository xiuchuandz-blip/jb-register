# jb-register (GhostReg) — Python / FastAPI + 浏览器自动化
# 仅用于 GitHub Actions 构建 arm64 镜像；x86 源码部署(nixpacks)不使用此文件。
FROM python:3.11-slim

WORKDIR /app

# DrissionPage(ghostreg) 运行时需要 Chromium；ca-certificates 供 HTTPS。
# 如果你只用 HTTP 协议注册(protocol_reg)、不需要浏览器，可删掉这一段以减小镜像。
RUN apt-get update && apt-get install -y --no-install-recommends \
      chromium \
      ca-certificates \
    && rm -rf /var/lib/apt/lists/*
ENV CHROME_PATH=/usr/bin/chromium

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PORT=5000
EXPOSE 5000

# shell 形式：让 Zeabur 注入的 $PORT 生效（默认 5000）
CMD python -m ghostreg --no-browser --host 0.0.0.0 --port ${PORT:-5000}
